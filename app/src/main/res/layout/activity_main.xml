<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".MainActivity">


    <ImageView
        android:id="@+id/imageView"
        android:layout_width="160dp"
        android:layout_height="111dp"
        android:layout_marginBottom="4dp"
        android:cropToPadding="@android:bool/config_enableMaterialDesignInPackageInstaller"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cinema_logo" />

    <ImageButton
        android:id="@+id/btnImgObsession"
        android:layout_width="321dp"
        android:layout_height="127dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="108dp"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/featured_film_2" />

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="274dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="248dp"
        android:hint="@string/search"
        android:inputType="text"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/imgSearch"
        android:layout_width="51dp"
        android:layout_height="48dp"
        android:layout_marginStart="292dp"
        android:layout_marginTop="248dp"
        android:backgroundTint="#000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/ic_menu_search" />

    <ImageView
        android:id="@+id/imgDiscountContainer"
        android:layout_width="185dp"
        android:layout_height="129dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="300dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/editbox_background_normal"
        app:tint="#1A180A" />

    <TextView
        android:id="@+id/tvDiscount"
        android:layout_width="149dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="336dp"
        android:text="20% Student Discount"
        android:textColor="#F8F4F4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnApplyStudent"
        android:layout_width="145dp"
        android:layout_height="39dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="352dp"
        android:backgroundTint="#FFC736"
        android:text="Apply"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgDiscountContainer2"
        android:layout_width="180dp"
        android:layout_height="129dp"
        android:layout_marginStart="184dp"
        android:layout_marginTop="300dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/editbox_background"
        app:tint="#1A180A" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="246dp"
        android:layout_marginTop="337dp"
        android:text="Fiver Fridays"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/BtnApplyFiver"
        android:layout_width="145dp"
        android:layout_height="39dp"
        android:layout_marginStart="219dp"
        android:layout_marginTop="356dp"
        android:backgroundTint="#FFC736"
        android:text="Apply"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="85dp"
        android:layout_height="115dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="440dp"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/wildwood" />

    <ImageView
        android:id="@+id/imgClayface"
        android:layout_width="85dp"
        android:layout_height="115dp"
        android:layout_marginStart="163dp"
        android:layout_marginTop="440dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/clayface" />

    <ImageView
        android:id="@+id/imgStarwars"
        android:layout_width="85dp"
        android:layout_height="115dp"
        android:layout_marginStart="284dp"
        android:layout_marginTop="440dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/starwars" />

    <Button
        android:id="@+id/btnViewWildwood"
        android:layout_width="82dp"
        android:layout_height="44dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="570dp"
        android:backgroundTint="#1A180A"
        android:text="view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/button2"
        android:layout_width="82dp"
        android:layout_height="44dp"
        android:layout_marginStart="164dp"
        android:layout_marginTop="570dp"
        android:backgroundTint="#1A180A"
        android:text="view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnViewStarwars"
        android:layout_width="82dp"
        android:layout_height="44dp"
        android:layout_marginStart="287dp"
        android:layout_marginTop="570dp"
        android:backgroundTint="#1A180A"
        android:text="view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#47411D"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>