<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".MainActivity">


    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

    </FrameLayout>

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="328dp"
        android:layout_height="613dp"
        android:paddingBottom="@dimen/material_emphasis_disabled"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/cinema_logo"
        tools:layout_editor_absoluteY="-250dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#47411D"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/frameLayout"
        app:menu="@menu/bottom_nav_menu">

    </com.google.android.material.bottomnavigation.BottomNavigationView>

    <ImageButton
        android:id="@+id/btnImgObsession"
        android:layout_width="321dp"
        android:layout_height="127dp"
        android:paddingLeft="@dimen/material_emphasis_disabled"
        android:paddingTop="@dimen/material_emphasis_disabled"
        android:paddingRight="@dimen/material_emphasis_disabled"
        android:paddingBottom="@dimen/material_emphasis_disabled"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/featured_film_2"
        tools:layout_editor_absoluteX="45dp"
        tools:layout_editor_absoluteY="113dp" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="85dp"
        android:layout_height="115dp"
        android:paddingStart="@dimen/material_emphasis_disabled"
        android:paddingLeft="@dimen/material_emphasis_disabled"
        android:paddingTop="@dimen/material_emphasis_disabled"
        android:paddingRight="@dimen/material_emphasis_disabled"
        android:paddingBottom="@dimen/material_emphasis_disabled"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/wildwood"
        tools:layout_editor_absoluteX="36dp"
        tools:layout_editor_absoluteY="440dp" />

    <Button
        android:id="@+id/btnViewWildwood"
        android:layout_width="82dp"
        android:layout_height="44dp"
        android:backgroundTint="#1A180A"
        android:text="view"
        tools:layout_editor_absoluteX="36dp"
        tools:layout_editor_absoluteY="570dp" />

    <Button
        android:id="@+id/button2"
        android:layout_width="82dp"
        android:layout_height="44dp"
        android:backgroundTint="#1A180A"
        android:text="view"
        tools:layout_editor_absoluteX="164dp"
        tools:layout_editor_absoluteY="570dp" />

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="274dp"
        android:layout_height="39dp"
        android:ems="10"
        android:inputType="text"
        android:text="Search"
        android:textColorHint="@color/white"
        tools:layout_editor_absoluteX="46dp"
        tools:layout_editor_absoluteY="257dp" />

    <ImageButton
        android:id="@+id/imgSearch"
        android:layout_width="51dp"
        android:layout_height="48dp"
        android:backgroundTint="#000000"
        app:srcCompat="@android:drawable/ic_menu_search"
        tools:layout_editor_absoluteX="323dp"
        tools:layout_editor_absoluteY="248dp" />

    <ImageView
        android:id="@+id/imgClayface"
        android:layout_width="85dp"
        android:layout_height="115dp"
        app:srcCompat="@drawable/clayface"
        tools:layout_editor_absoluteX="163dp"
        tools:layout_editor_absoluteY="440dp" />

    <ImageView
        android:id="@+id/imgDiscountContainer"
        android:layout_width="185dp"
        android:layout_height="129dp"
        app:srcCompat="@android:drawable/editbox_background_normal"
        app:tint="#1A180A"
        tools:layout_editor_absoluteX="25dp"
        tools:layout_editor_absoluteY="301dp" />

    <Button
        android:id="@+id/btnApplyStudent"
        android:layout_width="145dp"
        android:layout_height="39dp"
        android:backgroundTint="#FFC736"
        android:text="Apply"
        tools:layout_editor_absoluteX="41dp"
        tools:layout_editor_absoluteY="356dp" />

    <TextView
        android:id="@+id/tvDiscount"
        android:layout_width="149dp"
        android:layout_height="27dp"
        android:text="20% Student Discount"
        android:textColor="#F8F4F4"
        tools:layout_editor_absoluteX="46dp"
        tools:layout_editor_absoluteY="336dp" />

    <ImageView
        android:id="@+id/imgStarwars"
        android:layout_width="85dp"
        android:layout_height="115dp"
        app:srcCompat="@drawable/starwars"
        tools:layout_editor_absoluteX="284dp"
        tools:layout_editor_absoluteY="440dp" />

    <Button
        android:id="@+id/btnViewStarwars"
        android:layout_width="82dp"
        android:layout_height="44dp"
        android:backgroundTint="#1A180A"
        android:text="view"
        tools:layout_editor_absoluteX="287dp"
        tools:layout_editor_absoluteY="570dp" />

    <ImageView
        android:id="@+id/imgDiscountContainer2"
        android:layout_width="180dp"
        android:layout_height="129dp"
        android:backgroundTint="#1A180A"
        android:tint="#1A180A"
        app:srcCompat="@android:drawable/editbox_background"
        tools:layout_editor_absoluteX="202dp"
        tools:layout_editor_absoluteY="301dp" />

    <Button
        android:id="@+id/BtnApplyFiver"
        android:layout_width="145dp"
        android:layout_height="39dp"
        android:backgroundTint="#FFC736"
        android:text="Apply"
        tools:layout_editor_absoluteX="219dp"
        tools:layout_editor_absoluteY="356dp" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fiver Fridays"
        android:textColor="@color/white"
        tools:layout_editor_absoluteX="246dp"
        tools:layout_editor_absoluteY="337dp" />

</androidx.constraintlayout.widget.ConstraintLayout>