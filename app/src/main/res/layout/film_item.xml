<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="12dp">
    <ImageView android:id="@+id/imgFilm"
        android:layout_width="110dp" android:layout_height="90dp"
        android:scaleType="centerCrop"
        android:contentDescription="Film picture"/>
    <LinearLayout android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="12dp">
        <TextView android:id="@+id/tvFilmName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvFilmInfo"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
